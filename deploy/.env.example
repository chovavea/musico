# 复制为 .env 后再改。密码可以包含 @ : / # 等 URL 特殊字符：容器内的连接串
# 由 compose.yaml 传 DATABASE_HOST / DATABASE_PASSWORD 给 settings.py 拼装并转义。
POSTGRES_USER=musico
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=musico

# 强烈建议填写（服务暴露在网络上时必填）。填了之后写操作（下载/排序/删除）与
# 曲库、下载记录的读取都必须带令牌：浏览器在「配置」菜单里填同一个值（只存
# 本机），命令行用 -H "Authorization: Bearer <token>"。
API_TOKEN=

# 以下应用设置可选，留空即用默认值。
# ENABLE_MEDIA_RESOLVER=false
# LOG_LEVEL=INFO
# STALENESS_MULTIPLIER=2

# 可选：Ventura 下载源站点地址。留空则跳过该源。
MUSICO_DL_VENTURA_BASE_URL=

# 可选：下载失败后跳转的外部网盘站。留空则关闭兜底。
MUSICO_FALLBACK_BASE_URL=
MUSICO_FALLBACK_EXTRA_HOSTS=

# 可选：页面内试听源。留空则跳过。
MUSICO_LISTEN_FLMP3_BASE_URL=
MUSICO_LISTEN_FLMP3_EXTRA_HOSTS=
MUSICO_LISTEN_GEQUBAO_BASE_URL=
MUSICO_LISTEN_GEQUBAO_EXTRA_HOSTS=
