# Copy to .env and edit there: compose injects this whole file into the app
# container (env_file), so a new app setting the code reads via Settings needs
# no docker-compose change. Ports, volumes, images and in-container paths still
# have to be changed in compose.yaml.
# Values that describe the container itself (DATABASE_URL, BOARDS_YAML,
# MUSIC_LIBRARY_DIR, DOWNLOAD_SOURCE_*, TZ) are still overridden by
# compose.yaml on purpose.
POSTGRES_USER=musico
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=musico
# Either the whole URL, or the parts below it. Every setting also accepts
# ``<ALIAS>_FILE`` (Docker's convention), which is how a deployment keeps the
# password out of the container environment: set DATABASE_PASSWORD_FILE instead
# of DATABASE_PASSWORD and point it at a mounted secret file. When both
# DATABASE_URL and DATABASE_HOST are absent, POSTGRES_* above fill in a
# 127.0.0.1 URL for local runs.
DATABASE_URL=postgresql+psycopg://musico:CHANGE_ME@127.0.0.1:5432/musico
# DATABASE_HOST=127.0.0.1
# DATABASE_PORT=5432
# DATABASE_USER=musico
# DATABASE_NAME=musico
# DATABASE_PASSWORD_FILE=/run/secrets/musico_db_password
ENABLE_MEDIA_RESOLVER=false
LOG_LEVEL=INFO
API_TOKEN=
STALENESS_MULTIPLIER=2
MUSIC_LIBRARY_DIR=/app/data/music
DOWNLOAD_SOURCE_CONFIG=/app/configs/download_sources.yaml
DOWNLOAD_SOURCE_DIRS=
# Required by the Ventura plugin declared in configs/download_sources.yaml.
# Leave empty to skip that plugin; downloads then fall through to the link-out
# fallback below (if MUSICO_FALLBACK_BASE_URL is set).
MUSICO_DL_VENTURA_BASE_URL=
DOWNLOAD_MAX_RETRIES=3
DOWNLOAD_TIMEOUT_SEC=300
DOWNLOAD_MAX_FILE_SIZE=2147483648
DOWNLOAD_POLL_SEC=1
DOWNLOAD_LEASE_SEC=60
PREVIEW_CROSS_PLATFORM=true
PREVIEW_MATCH_MIN_SCORE=0.9
PREVIEW_MAX_CANDIDATES=2
PREVIEW_CALL_TIMEOUT_SEC=60
PREVIEW_DEADLINE_SEC=60
PREVIEW_NEGATIVE_TTL_SEC=180
PREVIEW_POSITIVE_TTL_SEC=600
PREVIEW_ADAPTIVE_ORDER=true
# Same-tier providers are ranked by recent playable-first-byte cost. Old
# observations lose half their weight every 3 days; exploration keeps recovered
# and newly added providers from being ignored forever.
PREVIEW_EXPLORE_WEIGHT=0.08
PREVIEW_DECAY_HALF_LIFE_SEC=259200
# Same-tier delayed hedge: start the next provider after this delay if the
# current one has not produced audio yet. At most two providers run at once.
PREVIEW_HEDGE_ENABLED=true
PREVIEW_HEDGE_MIN_DELAY_SEC=0.4
PREVIEW_HEDGE_MAX_DELAY_SEC=1.5
# Link-out fallback (optional): when a download task finally fails, the browser
# is sent to this site's netdisk share page and the user finishes the transfer
# there.  Leave MUSICO_FALLBACK_BASE_URL empty to disable the feature entirely
# (no resolver is built and no request is ever made).
MUSICO_FALLBACK_BASE_URL=
# Comma-separated extra hosts allowed for the fallback resolver (e.g. mirrors).
MUSICO_FALLBACK_EXTRA_HOSTS=
FALLBACK_TIMEOUT_SEC=15
FALLBACK_POSITIVE_TTL_SEC=604800
FALLBACK_NEGATIVE_TTL_SEC=300
FALLBACK_EVENT_LIMIT=20
# Optional T4 listen provider: site search + /api/playurl.php in-page mp3.
# Leave empty to skip this provider.
MUSICO_LISTEN_FLMP3_BASE_URL=
MUSICO_LISTEN_FLMP3_EXTRA_HOSTS=
# Optional T4 listen provider: site search + POST /member/common-play-url.
# Leave empty to skip this provider.
MUSICO_LISTEN_GEQUBAO_BASE_URL=
MUSICO_LISTEN_GEQUBAO_EXTRA_HOSTS=
